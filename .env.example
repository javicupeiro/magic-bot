# Required for uncached embeddings and answer generation. Environment overrides .env.
OPENAI_API_KEY="your_openai_api_key_here"
# Explicit embedding model and output vector size.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Responses API model and reasoning effort for routing, card tools, generation and review.
OPENAI_LLM_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=high
# Optional Langfuse tracing. Both keys are required. Leave them empty to stay disabled.
# Set LANGFUSE_TRACING_ENABLED=true after adding keys. false forces tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
# Optional concurrent API execution threads (default 8; Render image: 1).
# Compose forwards this from .env. For local uvicorn, export it in the shell;
# the executor starts before the workflow loads .env. Keep --workers 1 in uvicorn.
# MAGIC_BOT_MAX_WORKERS=1
# Optional host port used by Compose (container always listens on 8000).
# MAGIC_BOT_PORT=8015
