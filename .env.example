# Required for uncached embeddings and answer generation. Environment overrides .env.
OPENAI_API_KEY="your_openai_api_key_here"
# Explicit embedding model and output vector size.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Responses API model and reasoning effort for normalization and generation.
OPENAI_LLM_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=high
# Optional Langfuse tracing. Both keys are required. Leave them empty to stay disabled.
# Set LANGFUSE_TRACING_ENABLED=true after adding keys. false forces tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
# Optional simultaneous API execution workers (default 8 locally; Render image: 1).
# MAGIC_BOT_MAX_WORKERS=1
