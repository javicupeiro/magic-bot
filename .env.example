# Required for uncached embeddings and answer generation. Environment overrides .env.
OPENAI_API_KEY="your_openai_api_key_here"
# Explicit embedding model and output vector size.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Responses API model and reasoning effort for normalization and generation.
OPENAI_LLM_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=high
