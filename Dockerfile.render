FROM ghcr.io/astral-sh/uv:0.8.2 AS uv
FROM python:3.12-slim-bookworm

COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    MAGIC_BOT_MAX_WORKERS=1 \
    LANGFUSE_TRACING_ENABLED=false
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked --no-dev --no-install-project
COPY backend/ backend/
COPY frontend/ frontend/
COPY README.md ./
RUN uv sync --locked --no-dev --no-editable
COPY deploy/index_bundle.py deploy/rules.jsonl.gz deploy/
# Rebuild native HNSW files on the target platform; no API key during builds.
RUN python deploy/index_bundle.py restore \
    && rm deploy/rules.jsonl.gz \
    && python -c "from backend.retrieval.retrieval import Retriever; assert Retriever().rule('702.7b')" \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app \
    && mkdir -p data/conversations \
    && chown -R app:app data
USER app
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn backend.api.app:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
